# Host-side development values. Load with: set -a; . ./.env; set +a
# The skeleton does not parse these yet; implement parsing in the coding test.
SHELLY_URL=http://localhost:8081
MQTT_BROKER=tcp://localhost:1883
POLL_INTERVAL=5s
HTTP_TIMEOUT=3s
# Optional auth/TLS extension (start with make -C .. up-secure):
# SHELLY_URL=https://localhost:8443
# SHELLY_USERNAME=admin
# SHELLY_PASSWORD=admin
# TLS_INSECURE_SKIP_VERIFY=true
